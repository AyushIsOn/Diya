<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DiyaMeditation.Views.HomeView"
             Background="White">

    <Grid ColumnDefinitions="*,*" Margin="64">

        <!-- Left panel: Welcome + registered visitor + Start -->
        <Border Grid.Column="0" Margin="0,0,24,0" BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="16" Padding="64">
            <StackPanel VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="Welcome" FontSize="56" FontWeight="Bold" Foreground="#1F2A37" />
                <TextBlock Text="Take a moment for yourself." FontSize="18" Foreground="#9CA3AF" />

                <StackPanel Name="DetailsPanel" IsVisible="False" Spacing="4" Margin="0,12,0,0">
                    <TextBlock Name="NameText" FontSize="24" FontWeight="SemiBold" Foreground="#111827"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="EmailText" FontSize="15" Foreground="#6B7280"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="AgeText" FontSize="15" Foreground="#6B7280" />
                </StackPanel>

                <Button Content="Start Calibration" Click="OnStartCalibration"
                        Background="#111827" Foreground="White" FontSize="18" FontWeight="SemiBold"
                        Padding="36,18" CornerRadius="10" HorizontalAlignment="Left" Margin="0,8,0,0" />

                <TextBlock Name="StatusText" FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Right panel: the QR is the hero. Manual entry is tucked away. -->
        <Border Grid.Column="1" Margin="24,0,0,0" BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="16" Padding="48">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">

                <StackPanel Spacing="4">
                    <TextBlock Text="Scan to begin" FontSize="24" FontWeight="SemiBold"
                               Foreground="#1F2A37" HorizontalAlignment="Center" />
                    <TextBlock Name="ScanHint" Text="Point your phone camera at the code to register."
                               FontSize="14" Foreground="#9CA3AF" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="300" />
                </StackPanel>

                <Border Background="White" BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="16"
                        Padding="18" HorizontalAlignment="Center" BoxShadow="0 8 28 0 #11000000">
                    <Panel Width="230" Height="230">
                        <Image Name="QrImage" Width="230" Height="230" />
                        <TextBlock Name="QrPlaceholder" Text="Connecting…"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9CA3AF" />
                    </Panel>
                </Border>

                <TextBlock Name="LiveStatus" Text="Waiting for you to register…"
                           FontSize="15" FontWeight="SemiBold" Foreground="#9CA3AF"
                           TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />

                <Button Name="NewCodeButton" Content="Refresh code" Click="OnNewCode"
                        Background="Transparent" Foreground="#9CA3AF" FontSize="13"
                        BorderThickness="0" Padding="6,4" HorizontalAlignment="Center" />

                <Expander Header="Enter details instead" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <StackPanel Spacing="10" Margin="0,12,0,0">
                        <TextBox Name="NameBox" Watermark="Your name" FontSize="15" Width="260"
                                 Padding="12,10" CornerRadius="10" BorderBrush="#E5E7EB" />
                        <TextBox Name="EmailBox" Watermark="Email" FontSize="15" Width="260"
                                 Padding="12,10" CornerRadius="10" BorderBrush="#E5E7EB" />
                        <TextBox Name="AgeBox" Watermark="Age" FontSize="15" Width="260"
                                 Padding="12,10" CornerRadius="10" BorderBrush="#E5E7EB" />
                        <TextBlock Text="Then press Start Calibration." FontSize="12"
                                   Foreground="#9CA3AF" HorizontalAlignment="Center" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
