<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DiyaMeditation.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="DiyaMeditation.Views.MainWindow"
        Title="Diya Meditation"
        CanResize="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="White">

    <!-- The kiosk shell hosts the current screen; MainWindow swaps it via IKioskNavigator.
         A gentle cross-fade makes screen changes feel calm rather than abrupt. -->
    <TransitioningContentControl Name="ContentHost">
        <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.35" />
        </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
</Window>
